{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claim",
  "type": "object",
  "required": ["id", "type", "statement", "confidence", "status", "created"],
  "properties": {
    "id": {"type": "string"},
    "type": {"type": "string", "const": "claim"},
    "statement": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"type": "string", "enum": ["fact", "observation", "evidence", "claim", "inference", "hypothesis", "speculation", "prediction", "unknown", "disputed", "false", "outdated"]},
    "domain": {"type": "string"},
    "supporting_evidence": {"type": "array", "items": {"type": "string"}},
    "contradicting_evidence": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "string"}},
    "falsification_criteria": {"type": "string"},
    "alternative_explanations": {"type": "array", "items": {"type": "string"}},
    "created": {"type": "string", "format": "date"},
    "last_reviewed": {"type": "string", "format": "date"}
  }
}
